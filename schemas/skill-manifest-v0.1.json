{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discourselens.com/schemas/skill-manifest-v0.1.json",
  "title": "DiscourseLens Skill Manifest v0.1",
  "type": "object",
  "required": ["id", "version", "framework", "execution_kind", "input_schema_ref", "output_schema_ref", "executor", "methodology_refs", "retrieval_plan_ref", "documentation_ref"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "framework": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "execution_kind": {"enum": ["DETERMINISTIC", "HYBRID", "LLM_ASSISTED"]},
    "input_schema_ref": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "output_schema_ref": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "model_input_schema_ref": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
    "model_output_schema_ref": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
    "executor": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "methodology_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "allowed_claims": {"type": "array", "items": {"enum": ["OBSERVATIONAL", "EXAMPLE_BASED", "INTERPRETIVE", "COMPARATIVE", "QUANTIFIED", "ABSENCE", "UNIVERSAL", "CONTEXTUAL"]}},
    "prohibited_claims": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "retrieval_plan_ref": {"type": "string", "pattern": "^\\s*retrieval/[\\s\\S]*\\S[\\s\\S]*$"},
    "prompt_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "documentation_ref": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "additionalProperties": false
}
