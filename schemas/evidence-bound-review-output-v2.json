{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["interpretation", "alternative_interpretation", "evidence_ids"],
  "properties": {
    "interpretation": {"type": "string", "minLength": 1},
    "alternative_interpretation": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "counterevidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"},
      "description": "Only literal-search candidates the critical reviewer concludes challenge the interpretation; each ID must also occur in evidence_ids."
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
