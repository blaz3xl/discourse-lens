{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discourselens.com/schemas/evidence-bound-review-model-output-v1.json",
  "title": "Evidence-bound review model JSON output v1",
  "description": "Provider-facing structured JSON response shape shared by framework review and synthesis; semantic and evidence-ID checks remain enforced by Core.",
  "type": "object",
  "required": ["interpretation", "alternative_interpretation", "evidence_ids", "counterevidence_ids", "limitations"],
  "properties": {
    "interpretation": {"type": "string"},
    "alternative_interpretation": {"type": "string"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "counterevidence_ids": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
