{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discourselens.com/schemas/research-bundle-v16.json",
  "title": "DiscourseLens Research Bundle v16",
  "description": "Version 15 provenance plus portable, secret-free extraction manifests and structure hashes for document revisions.",
  "type": "object",
  "required": [
    "bundle_version", "project_format_version", "analysis_run", "findings",
    "finding_lineage", "evidence", "finding_evidence_spans", "canonical_texts", "document_revisions",
    "skill_runs", "coverage_descriptors", "model_executions", "retrieval_runs",
    "retrieval_hits", "reranking_runs", "reranking_hits", "human_reviews",
    "qualitative_coding", "integrity"
  ],
  "properties": {
    "bundle_version": {"const": 16},
    "project_format_version": {"$ref": "research-bundle-v15.json#/properties/project_format_version"},
    "analysis_run": {"$ref": "research-bundle-v15.json#/properties/analysis_run"},
    "findings": {"$ref": "research-bundle-v15.json#/properties/findings"},
    "finding_lineage": {"$ref": "research-bundle-v15.json#/properties/finding_lineage"},
    "evidence": {"$ref": "research-bundle-v15.json#/properties/evidence"},
    "finding_evidence_spans": {"$ref": "research-bundle-v15.json#/properties/finding_evidence_spans"},
    "canonical_texts": {"$ref": "research-bundle-v15.json#/properties/canonical_texts"},
    "document_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "document_id", "source_hash", "canonical_hash", "extractor",
          "mime_type", "ocr_language", "ocr_dpi", "extraction_manifest_json", "structure_hash"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "document_id": {"type": "string", "minLength": 1},
          "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "extractor": {"type": "string", "minLength": 1},
          "coordinate_scheme": {"type": "string", "minLength": 1},
          "mime_type": {"type": ["string", "null"]},
          "source_size": {"type": ["integer", "null"], "minimum": 0},
          "created_at": {"type": "string", "minLength": 1},
          "ocr_language": {"type": ["string", "null"]},
          "ocr_dpi": {"type": ["integer", "null"], "minimum": 1},
          "extraction_manifest_json": {"type": "string", "minLength": 2, "maxLength": 65536},
          "structure_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "skill_runs": {"$ref": "research-bundle-v15.json#/properties/skill_runs"},
    "coverage_descriptors": {"$ref": "research-bundle-v15.json#/properties/coverage_descriptors"},
    "model_executions": {"$ref": "research-bundle-v15.json#/properties/model_executions"},
    "retrieval_runs": {"$ref": "research-bundle-v15.json#/properties/retrieval_runs"},
    "retrieval_hits": {"$ref": "research-bundle-v15.json#/properties/retrieval_hits"},
    "reranking_runs": {"$ref": "research-bundle-v15.json#/properties/reranking_runs"},
    "reranking_hits": {"$ref": "research-bundle-v15.json#/properties/reranking_hits"},
    "human_reviews": {"$ref": "research-bundle-v15.json#/properties/human_reviews"},
    "qualitative_coding": {"$ref": "research-bundle-v15.json#/properties/qualitative_coding"},
    "integrity": {"$ref": "research-bundle-v15.json#/properties/integrity"}
  },
  "additionalProperties": false
}
