{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discourselens.com/schemas/synthesis-executor-output-v1.json",
  "title": "Synthesis SkillExecutor output v1",
  "description": "JSON representation of the mapping returned by run_synthesis.",
  "type": "object",
  "required": ["finding_id", "skill_run_id"],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "skill_run_id": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "additionalProperties": false
}
