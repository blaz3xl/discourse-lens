{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TextualDescriptorsInputV1",
  "type": "object",
  "required": ["scope_id"],
  "properties": {
    "scope_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["en", "es"]},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
