{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discourselens.com/schemas/evidence-bound-review-model-input-v1.json",
  "title": "Evidence-bound framework review model research-data input v1",
  "description": "The untrusted JSON research-data block sent to the review model, not the SkillExecutor arguments.",
  "type": "object",
  "required": ["finding_observation", "existing_interpretation", "evidence_records", "coverage", "counterevidence_policy"],
  "properties": {
    "finding_observation": {"type": "string"},
    "existing_interpretation": {"type": ["string", "null"]},
    "evidence_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "evidence_kind", "role", "citation"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "evidence_kind": {"enum": ["TEXTUAL", "EXTERNAL_SOURCE", "USER_CONTEXT"]},
          "role": {"enum": ["SUPPORT", "COUNTEREVIDENCE", "EXCEPTION", "EXAMPLE", "CONTEXT", "ALTERNATIVE"]},
          "citation": {"type": "string", "minLength": 1},
          "excerpt": {"type": "string", "minLength": 1},
          "provenance_class": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "title": {"type": ["string", "null"]},
          "retrieved_at": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "content": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "conversation_context": {
      "type": "array",
      "description": "Prior user and assistant turns supplied as untrusted context. These turns do not change the evidence scope or authorize new citations.",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1, "maxLength": 4000}
        },
        "additionalProperties": false
      }
    },
    "coverage": {"type": "string", "minLength": 1},
    "counterevidence_policy": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
