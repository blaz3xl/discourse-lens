{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["source_findings", "evidence_records"],
  "properties": {
    "source_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["finding_id", "skill_id", "phenomenon", "observation"],
        "properties": {
          "finding_id": {"type": "string"},
          "skill_id": {"type": "string"},
          "phenomenon": {"type": "string"},
          "observation": {"type": "string"},
          "interpretation": {"type": ["string", "null"]},
          "alternative_interpretation": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "excerpt"],
        "properties": {
          "evidence_id": {"type": "string"},
          "excerpt": {"type": "string"}
        }
      }
    }
  }
}
