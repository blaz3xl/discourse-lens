{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discourselens.com/schemas/van-dijk-group-comparison-input-v1.json",
  "title": "Van Dijk Group Comparison Preparation Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "groups",
    "shared_topic_event",
    "comparability_basis",
    "codebook_id"
  ],
  "properties": {
    "groups": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "contains": {
        "type": "object",
        "required": ["annotation_ids"],
        "properties": {
          "annotation_ids": {"type": "array", "minItems": 1}
        }
      },
      "minContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "annotation_ids"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "annotation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        }
      }
    },
    "shared_topic_event": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "comparability_basis": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "codebook_id": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
