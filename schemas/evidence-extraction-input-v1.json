{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discourselens.com/schemas/evidence-extraction-input-v1.json",
  "title": "Descriptive Evidence Extraction Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope_snapshot_id"],
  "properties": {
    "scope_snapshot_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "default": ["en", "es"],
      "items": {"enum": ["en", "es"]}
    },
    "max_examples": {"type": "integer", "minimum": 1, "maximum": 256, "default": 48}
  }
}
