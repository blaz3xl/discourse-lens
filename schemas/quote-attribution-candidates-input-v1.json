{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discourselens.com/schemas/quote-attribution-candidates-input-v1.json",
  "title": "Quotation and Attribution Candidate Inventory Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope_snapshot_id"],
  "properties": {
    "scope_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision_languages": {
      "type": "object",
      "minProperties": 1,
      "description": "Optional explicit language assignment for every revision in the original scope. Attribution cues support en and es only.",
      "additionalProperties": {
        "enum": ["en", "es"]
      }
    }
  }
}
