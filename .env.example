# Copy to .env for a self-hosted browser workspace. Keep .env private.
COMPOSE_PROJECT_NAME=discourselens
DISCOURSELENS_PROJECT_DIR=./data/discourselens-project

# The local browser login keeps accounts in the project directory. Generate
# the session secret once and keep it stable across restarts.
DISCOURSELENS_WEB_SESSION_SECRET=
DISCOURSELENS_WEB_ALLOW_REGISTRATION=true
DISCOURSELENS_WEB_COOKIE_SECURE=false
# Chat diagnostics are off by default. When on, logs include prompts, model
# responses, and tool results; enable only temporarily while debugging.
DISCOURSELENS_DEBUG=off
# Comma-separated HTTPS origins accepted for browser session requests. Add a
# temporary tunnel origin alongside the stable workers.dev origin when needed.
DISCOURSELENS_WEB_PUBLIC_ORIGIN=

# Required to store reusable provider API keys encrypted in the project database.
# Generate with: python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
DISCOURSELENS_CREDENTIALS_ENCRYPTION_KEY=

DISCOURSELENS_WEB_PORT=8000
DISCOURSELENS_UID=10001
DISCOURSELENS_GID=10001
DISCOURSELENS_PROVIDER_ENV_FILE=./provider.env

# Optional MCP HTTP service. Set a bearer token before starting it. Tenant keys
# are only needed for OIDC-backed tenant routing, such as the Cloudflare bridge.
DISCOURSELENS_MCP_HTTP_TOKEN=
DISCOURSELENS_TENANT_ID_KEY=
DISCOURSELENS_MCP_TENANT_SIGNING_KEY=
DISCOURSELENS_MCP_HTTP_PORT=8001
DISCOURSELENS_MCP_PUBLIC_URL=
DISCOURSELENS_MCP_CONNECTOR_MODE=
